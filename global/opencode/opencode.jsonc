{
  "$schema": "https://opencode.ai/config.json",

  "plugin": [
    "oh-my-opencode-slim"
  ],

  // Privacy / update preferences.
  "share": "disabled",
  "autoupdate": false,

  // Only expose providers you actually intend to use.
  "enabled_providers": [
    "openai",
    "github-copilot",
    "livai"
  ],

  "provider": {
    "livai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LivAI API",

      "options": {
        "baseURL": "https://livai-api.llnl.gov",
        // TODO: INSERT LIVAI API KEY HERE
        "apiKey": "<INSERT LIVAI API KEY HERE>",
        "includeUsage": true,
        "apiVersion": "preview"
      },

      "models": {
        "gpt-5.5": {
          "name": "GPT-5.5",

          // Based on the LivAI pricing you provided.
          "cost": {
            "input": 5.0,
            "output": 30.0
          },

          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          },

          "variants": {
            "xhigh": {
              "reasoningEffort": "xhigh",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            },

            "high": {
              "reasoningEffort": "high",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            },

            "none": {
              "reasoningEffort": "none",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            }
          }
        },

        "gpt-5.4": {
          "name": "GPT-5.4",

          "cost": {
            "input": 2.5,
            "output": 15.0
          },

          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          },

          "variants": {
            "xhigh": {
              "reasoningEffort": "xhigh",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            },

            "high": {
              "reasoningEffort": "high",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            },

            "none": {
              "reasoningEffort": "none",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            }
          }
        },

        "gpt-5-mini": {
          "name": "GPT-5 Mini"
        },

        "gpt-5-nano": {
          "name": "GPT-5 Nano"
        },

        "claude-sonnet-4.5": {
          "name": "Claude Sonnet 4.5",

          "variants": {
            "thinking": {
              "thinking": {
                "type": "enabled"
              }
            },

            "none": {
              "thinking": {
                "type": "disabled"
              }
            }
          }
        }
      }
    }
  },

  "permission": {
    "skill": "allow",

    "bash": {
      "*": "ask",

      // Common safe development commands.
      "git *": "allow",
      "grep *": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "npm *": "allow",
      "uv *": "allow",
      "pytest *": "allow",
      "ruff *": "allow",

      // Require confirmation for arbitrary network requests.
      "curl *": "ask",

      // Never allow destructive rm automatically.
      "rm *": "deny"
    }
  }
}