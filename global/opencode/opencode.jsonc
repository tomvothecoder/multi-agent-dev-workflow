{
  "$schema": "https://opencode.ai/config.json",

  "plugin": [
    "oh-my-opencode-slim"
  ],

  // Privacy / update preferences.
  "share": "disabled",
  "autoupdate": false,

  // Only expose providers you actually intend to use.
  "enabled_providers": [
    "openai",
    "github-copilot",
    "livai"
  ],

  "provider": {
    "livai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LivAI API",

      "options": {
        "baseURL": "https://livai-api.llnl.gov",
        // TODO: INSERT LIVAI API KEY HERE
        "apiKey": "<INSERT LIVAI API KEY HERE>",
        "includeUsage": true,
        "apiVersion": "preview"
      },

      "models": {
        "gpt-5.5": {
          "name": "GPT-5.5",

          // Based on the LivAI pricing you provided.
          "cost": {
            "input": 5.0,
            "output": 30.0
          },

          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          },

          "variants": {
            "xhigh": {
              "reasoningEffort": "xhigh",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            },

            "high": {
              "reasoningEffort": "high",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            },

            "none": {
              "reasoningEffort": "none",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            }
          }
        },

        "gpt-5.4": {
          "name": "GPT-5.4",

          "cost": {
            "input": 2.5,
            "output": 15.0
          },

          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          },

          "variants": {
            "xhigh": {
              "reasoningEffort": "xhigh",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            },

            "high": {
              "reasoningEffort": "high",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            },

            "none": {
              "reasoningEffort": "none",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            }
          }
        },

        "gpt-5-mini": {
          "name": "GPT-5 Mini"
        },

        "gpt-5-nano": {
          "name": "GPT-5 Nano"
        },

        "claude-sonnet-4.5": {
          "name": "Claude Sonnet 4.5",

          "variants": {
            "thinking": {
              "thinking": {
                "type": "enabled"
              }
            },

            "none": {
              "thinking": {
                "type": "disabled"
              }
            }
          }
        }
      }
    }
  },

  "permission": {
    "skill": "allow",

    "bash": {
      "*": "ask",

      // Common safe development commands.
      "git *": "allow",
      "grep *": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "npm *": "allow",
      "uv *": "allow",
      "pytest *": "allow",
      "ruff *": "allow",

      // Require confirmation for arbitrary network requests.
      "curl *": "ask",

      // Never allow destructive rm automatically.
      "rm *": "deny"
    }
  },

  "default_agent": "workflow-orchestrator",
  "subagent_depth": 1,

  "agent": {
    "workflow-orchestrator": {
      "description": "Plans work, delegates bounded tasks, runs final checks, and coordinates independent review.",
      "model": "openai/gpt-5.6-sol",
      "mode": "primary",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "bash": "allow",
        "task": {
          "*": "deny",
          "explore": "allow",
          "general": "allow",
          "workflow-reviewer": "allow"
        },
        "todowrite": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "lsp": "allow",
        "skill": "allow",
        "external_directory": "ask"
      },
      "reasoningEffort": "high",
      "textVerbosity": "low"
    },
    "explore": {
      "description": "Performs fast, read-only repository discovery and returns concise findings.",
      "model": "openai/gpt-5.6-luna",
      "mode": "subagent",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": "allow",
        "external_directory": "deny"
      },
      "reasoningEffort": "low",
      "textVerbosity": "low"
    },
    "workflow-reviewer": {
      "description": "Independently reviews the requested behavior, resulting changes, and test evidence without modifying files.",
      "model": "github-copilot/claude-sonnet-5",
      "mode": "subagent",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "skill": "allow",
        "external_directory": "deny"
      }
    },
    "general": {
      "description": "Implements well-scoped delegated work, including edits and relevant tests; use for independent parallel work.",
      "prompt": "Handle only the assigned scope. Make minimal changes, respect repository instructions and file ownership, run relevant checks, and report changed files, test results, and blockers. Do not commit, push, or modify unrelated files.",
      "model": "openai/gpt-5.6-terra",
      "mode": "subagent",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "lsp": "allow",
        "skill": "allow",
        "external_directory": "deny"
      },
      "reasoningEffort": "medium",
      "textVerbosity": "low"
    },
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  }
}
