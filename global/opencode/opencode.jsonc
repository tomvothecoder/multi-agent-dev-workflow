{
  "$schema": "https://opencode.ai/config.json",

  // Privacy / update preferences.
  "share": "disabled",
  "autoupdate": false,

  "default_agent": "livai-primary",
  "subagent_depth": 1,

  // Only expose providers you actually intend to use.
  "enabled_providers": [
    "openai",
    "github-copilot",
    "livai"
  ],

  "provider": {
    // Setup: https://llnl.servicenowservices.com/ess?id=kb_article_view&table=kb_knowledge&sys_id=62143123471ecb5408b62464336d43f4
    // List of models: https://livai-tools.llnl.gov/models
    "livai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LivAI API",

      "options": {
        "baseURL": "https://livai-api.llnl.gov",
        // TODO: INSERT LIVAI API KEY HERE
        "apiKey": "<INSERT LIVAI API KEY HERE>",
        "includeUsage": true,
        "apiVersion": "preview"
      },

      "models": {
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "variants": {
            "xhigh": { "reasoningEffort": "xhigh" },
            "high": { "reasoningEffort": "high" },
            "medium": { "reasoningEffort": "medium" },
            "low": { "reasoningEffort": "low" },
            "none": { "reasoningEffort": "none" }
          }
        },

        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "variants": {
            "xhigh": { "reasoningEffort": "xhigh" },
            "high": { "reasoningEffort": "high" },
            "medium": { "reasoningEffort": "medium" },
            "low": { "reasoningEffort": "low" },
            "none": { "reasoningEffort": "none" }
          }
        },

        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "variants": {
            "xhigh": { "reasoningEffort": "xhigh" },
            "high": { "reasoningEffort": "high" },
            "medium": { "reasoningEffort": "medium" },
            "low": { "reasoningEffort": "low" },
            "none": { "reasoningEffort": "none" }
          }
        }
      }
    }
  },

  "agent": {
    "primary": {
      "description": "Plans, implements, tests, and fixes the task end-to-end.",
      "mode": "primary",
      "model": "openai/gpt-6.1-sol",
      "variant": "medium",
      "reasoningEffort": "medium",
      "permission": {
        "task": { "*": "deny", "explorer": "allow", "reviewer": "allow" },
        "skill": "deny"
      },
      "prompt": "First determine the user's intent. For a question or request only to review, answer without editing files. For 'plan first', 'no code', or unclear authorization to implement, investigate as needed, present the requested answer or plan, and stop without editing files or running mutating commands; do not treat the plan as permission to implement. For an explicit implementation request, own the task through implementation and relevant verification without an unnecessary approval turn. Keep plans as simple, clean, and concise as possible while remaining robust and actionable. Use a formal plan only for non-trivial work, with headings Problem, Scope, Constraints and non-goals, Open questions (omit if none), Acceptance criteria, and Validation. Under Scope, use the fewest ordered phases needed, noting dependencies and intended logical commit boundaries briefly. Avoid repeated requirements, speculative work, unnecessary detail, and artificial tracks; retain essential risks and safeguards. Identify who must answer each open question and whether it blocks implementation; state non-blocking assumptions explicitly. Acceptance criteria must be observable and validation must name concrete checks or explain why none apply. Keep changes minimal, clean, cohesive, and robust: choose the smallest complete solution, follow existing repository patterns and formatting conventions, avoid unrelated refactors and speculative abstractions, and add or update tests for behavior changes. Implement one logical group at a time. Run focused tests and applicable formatting/lint checks before each authorized commit, then run broader validation after all phases. Commit only when explicitly authorized by the user or invoked command; implementation approval alone does not authorize commits. Before each commit, inspect git status, git diff, and git log --oneline -10; stage only intended changes, never secrets or unrelated user changes, skip empty commits, and use clear messages matching repository style. Do not push or open a PR without separate explicit authorization. After implementation, report under Result (what changed and the outcome), Validation (checks run and results, plus relevant checks not run and why), and Remaining issues (omit if none); say plainly if work is incomplete. Never use the implementation-results format for plan-only responses or claim checks ran when they did not. Honor user-specified formats and higher-priority repository instructions. Work directly by default. Ask explorer only a precise, read-only codebase question when it reduces material uncertainty. Ask reviewer once only after substantial changes and after running checks. Evaluate findings critically, fix valid ones, and rerun relevant checks. Do not use parallel edits, councils, fallback workers, or recursive delegation."
    },

    "explorer": {
      "description": "Performs targeted, read-only codebase investigation.",
      "mode": "subagent",
      "model": "openai/gpt-6-luna",
      "variant": "low",
      "reasoningEffort": "low",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "skill": { "*": "deny", "explore": "allow" },
        "external_directory": { "*": "deny", "~/worktrees/**": "allow" },
        "webfetch": "deny",
        "websearch": "deny"
      },
      "prompt": "Answer only the requested repository investigation. Search and read the codebase; do not edit files, run shell commands, browse the web, plan implementation, or delegate. Return concise findings with file paths and relevant symbols."
    },

    "livai-primary": {
      "description": "LivAI-backed primary agent that plans, implements, tests, and fixes end-to-end.",
      "mode": "primary",
      "model": "livai/gpt-5.6-terra",
      "variant": "medium",
      "reasoningEffort": "medium",
      "permission": {
        "task": { "*": "deny", "livai-explorer": "allow", "reviewer": "allow" },
        "skill": "deny"
      },
      "prompt": "First determine the user's intent. For a question or request only to review, answer without editing files. For 'plan first', 'no code', or unclear authorization to implement, investigate as needed, present the requested answer or plan, and stop without editing files or running mutating commands; do not treat the plan as permission to implement. For an explicit implementation request, own the task through implementation and relevant verification without an unnecessary approval turn. Keep plans as simple, clean, and concise as possible while remaining robust and actionable. Use a formal plan only for non-trivial work, with headings Problem, Scope, Constraints and non-goals, Open questions (omit if none), Acceptance criteria, and Validation. Under Scope, use the fewest ordered phases needed, noting dependencies and intended logical commit boundaries briefly. Avoid repeated requirements, speculative work, unnecessary detail, and artificial tracks; retain essential risks and safeguards. Identify who must answer each open question and whether it blocks implementation; state non-blocking assumptions explicitly. Acceptance criteria must be observable and validation must name concrete checks or explain why none apply. Keep changes minimal, clean, cohesive, and robust: choose the smallest complete solution, follow existing repository patterns and formatting conventions, avoid unrelated refactors and speculative abstractions, and add or update tests for behavior changes. Implement one logical group at a time. Run focused tests and applicable formatting/lint checks before each authorized commit, then run broader validation after all phases. Commit only when explicitly authorized by the user or invoked command; implementation approval alone does not authorize commits. Before each commit, inspect git status, git diff, and git log --oneline -10; stage only intended changes, never secrets or unrelated user changes, skip empty commits, and use clear messages matching repository style. Do not push or open a PR without separate explicit authorization. After implementation, report under Result (what changed and the outcome), Validation (checks run and results, plus relevant checks not run and why), and Remaining issues (omit if none); say plainly if work is incomplete. Never use the implementation-results format for plan-only responses or claim checks ran when they did not. Honor user-specified formats and higher-priority repository instructions. Work directly by default. Ask livai-explorer only a precise, read-only codebase question when it reduces material uncertainty. Ask reviewer once only after substantial changes and after running checks. Evaluate findings critically, fix valid ones, and rerun relevant checks. Do not use parallel edits, councils, fallback workers, or recursive delegation."
    },

    "livai-explorer": {
      "description": "LivAI-backed explorer for targeted, read-only codebase investigation.",
      "mode": "subagent",
      "model": "livai/gpt-5.6-luna",
      "variant": "low",
      "reasoningEffort": "low",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "skill": { "*": "deny", "explore": "allow" },
        "external_directory": { "*": "deny", "~/worktrees/**": "allow" },
        "webfetch": "deny",
        "websearch": "deny"
      },
      "prompt": "Answer only the requested repository investigation. Search and read the codebase; do not edit files, run shell commands, browse the web, plan implementation, or delegate. Return concise findings with file paths and relevant symbols."
    },

    "reviewer": {
      "description": "Independently reviews substantial completed changes without editing them.",
      "mode": "subagent",
      "model": "github-copilot/claude-opus-5.5",
      "permission": {
        "edit": "deny",
        "bash": { "*": "deny", "git status*": "allow", "git diff*": "allow", "git show*": "allow" },
        "task": "deny",
        "skill": { "*": "deny", "review": "allow" },
        "external_directory": { "*": "deny", "~/worktrees/**": "allow" },
        "webfetch": "deny",
        "websearch": "deny"
      },
      "prompt": "Independently review the completed implementation and provided check results. Focus on concrete correctness, regressions, edge cases, security, concurrency, error handling, API compatibility, unnecessary complexity, and missing tests. Do not modify code or delegate. Report only actionable findings, with file and line references when possible."
    }
  },

  "permission": {
    "skill": "allow",
    // Worktrees live at ~/worktrees/<repo>/<branch>. Last matching rule wins.
    // These grants do not override bash rules or agent-specific restrictions.
    "external_directory": {
      "*": "ask",
      "~/worktrees/**": "allow"
    },
    "edit": {
      "*": "allow",
      "~/worktrees/**": "allow"
    },
  "bash": {
    "*": "ask",

    "git *": "allow",
    "grep *": "allow",
    "ls *": "allow",
    "pwd": "allow",

    "uv *": "allow",
    "pytest *": "allow",
    "ruff *": "allow",

    // Frontend checks
    "pnpm run build": "allow",
    "pnpm run ci": "allow",
    "pnpm run type-check": "allow",
    "pnpm lint": "allow",
    "pnpm type-check": "allow",
    "pnpm --dir frontend run lint": "allow",
    "pnpm --dir frontend run type-check": "allow",
    "pnpm --dir frontend run ci": "allow",
    "pnpm --dir frontend run format:check": "allow",
    "make frontend-lint": "allow",
    "make frontend-build": "allow",

    // Backend and repository checks
    "make help": "allow",
    "make install": "allow",
    "make install-skills": "allow",
    "make install-commands": "allow",
    "make refresh-models": "allow",
    "make update-all": "allow",
    "make update-opencode": "allow",
    "make update-livai-models": "allow",
    "make update-agents": "allow",
    "make update-permissions": "allow",
    "make update-agents-md": "allow",
    "make update-skills": "allow",
    "make update-commands": "allow",
    "make update-skills-commands": "allow",
    "make install-nersc-rules": "allow",
    "make uninstall-nersc-rules": "allow",
    "make test": "allow",
    "make structure-test": "allow",
    "make backend-test": "allow",
    "make pre-commit-run": "allow",
    "uv run pytest *": "allow",
    "uv run ruff *": "allow",
    "uv run ty check": "allow",

    // Git inspection and intended PR workflow
    "git status *": "allow",
    "git diff *": "allow",
    "git show *": "allow",
    "git log *": "allow",
    "git branch *": "allow",
    "git remote *": "allow",
    "git add *": "allow",
    "git commit *": "allow",
    "git push *": "allow",
    "git ls-remote *": "allow",

    // GitHub issue and PR workflow
    "gh label list *": "allow",
    "gh issue comment *": "allow",
    "gh issue create *": "allow",
    "gh issue list *": "allow",
    "gh issue edit *": "allow",
    "gh issue view *": "allow",
    "gh pr comment *": "allow",
    "gh pr create *": "allow",
    "gh pr edit *": "allow",
    "gh pr list *": "allow",
    "gh pr view *": "allow",
    "gh repo view *": "allow",
    "gh api *": "allow",

    "curl *": "ask",
    "rm *": "deny"
  }
}
}
