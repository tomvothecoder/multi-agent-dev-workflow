{
  "$schema": "https://opencode.ai/config.json",

  // Privacy / update preferences.
  "share": "disabled",
  "autoupdate": false,

  "default_agent": "livai-primary",
  "subagent_depth": 1,

  // Only expose providers you actually intend to use.
  "enabled_providers": [
    "openai",
    "github-copilot",
    "livai"
  ],

  "provider": {
    // Setup: https://llnl.servicenowservices.com/ess?id=kb_article_view&table=kb_knowledge&sys_id=62143123471ecb5408b62464336d43f4
    // List of models: https://livai-tools.llnl.gov/models
    "livai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LivAI API",

      "options": {
        "baseURL": "https://livai-api.llnl.gov",
        // TODO: INSERT LIVAI API KEY HERE
        "apiKey": "<INSERT LIVAI API KEY HERE>",
        "includeUsage": true,
        "apiVersion": "preview"
      },

      "models": {
        "gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "variants": {
            "xhigh": { "reasoningEffort": "xhigh" },
            "high": { "reasoningEffort": "high" },
            "medium": { "reasoningEffort": "medium" },
            "low": { "reasoningEffort": "low" },
            "none": { "reasoningEffort": "none" }
          }
        },

        "gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "variants": {
            "xhigh": { "reasoningEffort": "xhigh" },
            "high": { "reasoningEffort": "high" },
            "medium": { "reasoningEffort": "medium" },
            "low": { "reasoningEffort": "low" },
            "none": { "reasoningEffort": "none" }
          }
        },

        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "variants": {
            "xhigh": { "reasoningEffort": "xhigh" },
            "high": { "reasoningEffort": "high" },
            "medium": { "reasoningEffort": "medium" },
            "low": { "reasoningEffort": "low" },
            "none": { "reasoningEffort": "none" }
          }
        }
      }
    }
  },

  "agent": {
    "primary": {
      "description": "Plans, implements, tests, and fixes the task end-to-end.",
      "mode": "primary",
      "model": "openai/gpt-6-sol",
      "variant": "medium",
      "reasoningEffort": "medium",
      "permission": {
        "task": { "*": "deny", "explorer": "allow", "reviewer": "allow" },
        "skill": "deny"
      },
      "prompt": "Own the task from plan through implementation and relevant verification. Work directly by default. Ask explorer only a precise, read-only codebase question when it reduces material uncertainty. Ask reviewer once only after substantial changes and after running checks. Evaluate findings critically, fix valid ones, and rerun relevant checks. Do not use parallel edits, councils, fallback workers, or recursive delegation."
    },

    "explorer": {
      "description": "Performs targeted, read-only codebase investigation.",
      "mode": "subagent",
      "model": "openai/gpt-6-luna",
      "variant": "low",
      "reasoningEffort": "low",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "skill": { "*": "deny", "explore": "allow" },
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      },
      "prompt": "Answer only the requested repository investigation. Search and read the codebase; do not edit files, run shell commands, browse the web, plan implementation, or delegate. Return concise findings with file paths and relevant symbols."
    },

    "livai-primary": {
      "description": "LivAI-backed primary agent that plans, implements, tests, and fixes end-to-end.",
      "mode": "primary",
      "model": "livai/gpt-5.6-terra",
      "variant": "medium",
      "reasoningEffort": "medium",
      "permission": {
        "task": { "*": "deny", "livai-explorer": "allow", "reviewer": "allow" },
        "skill": "deny"
      },
      "prompt": "Own the task from plan through implementation and relevant verification. Work directly by default. Ask livai-explorer only a precise, read-only codebase question when it reduces material uncertainty. Ask reviewer once only after substantial changes and after running checks. Evaluate findings critically, fix valid ones, and rerun relevant checks. Do not use parallel edits, councils, fallback workers, or recursive delegation."
    },

    "livai-explorer": {
      "description": "LivAI-backed explorer for targeted, read-only codebase investigation.",
      "mode": "subagent",
      "model": "livai/gpt-5.6-luna",
      "variant": "low",
      "reasoningEffort": "low",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "skill": { "*": "deny", "explore": "allow" },
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      },
      "prompt": "Answer only the requested repository investigation. Search and read the codebase; do not edit files, run shell commands, browse the web, plan implementation, or delegate. Return concise findings with file paths and relevant symbols."
    },

    "reviewer": {
      "description": "Independently reviews substantial completed changes without editing them.",
      "mode": "subagent",
      "model": "github-copilot/claude-sonnet-5",
      "permission": {
        "edit": "deny",
        "bash": { "*": "deny", "git status*": "allow", "git diff*": "allow", "git show*": "allow" },
        "task": "deny",
        "skill": { "*": "deny", "review": "allow" },
        "external_directory": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      },
      "prompt": "Independently review the completed implementation and provided check results. Focus on concrete correctness, regressions, edge cases, security, concurrency, error handling, API compatibility, unnecessary complexity, and missing tests. Do not modify code or delegate. Report only actionable findings, with file and line references when possible."
    }
  },

  "permission": {
    "skill": "allow",
  "bash": {
    "*": "ask",

    "git *": "allow",
    "grep *": "allow",
    "ls *": "allow",
    "pwd": "allow",

    "uv *": "allow",
    "pytest *": "allow",
    "ruff *": "allow",

    // Frontend checks
    "pnpm run build": "allow",
    "pnpm run ci": "allow",
    "pnpm run type-check": "allow",
    "pnpm lint": "allow",
    "pnpm type-check": "allow",
    "pnpm --dir frontend run lint": "allow",
    "pnpm --dir frontend run type-check": "allow",
    "pnpm --dir frontend run ci": "allow",
    "pnpm --dir frontend run format:check": "allow",
    "make frontend-lint": "allow",
    "make frontend-build": "allow",

    // Backend and repository checks
    "make help": "allow",
    "make install": "allow",
    "make install-opencode": "allow",
    "make install-opencode-config": "allow",
    "make install-skills": "allow",
    "make refresh-models": "allow",
    "make update-opencode": "allow",
    "make update-livai-models": "allow",
    "make update-agents": "allow",
    "make update-permissions": "allow",
    "make update-opencode-sections": "allow",
    "make update-agents-md": "allow",
    "make install-nersc-rules": "allow",
    "make uninstall-nersc-rules": "allow",
    "make test": "allow",
    "make structure-test": "allow",
    "make backend-test": "allow",
    "make pre-commit-run": "allow",
    "uv run pytest *": "allow",
    "uv run ruff *": "allow",
    "uv run ty check": "allow",

    // Git inspection and intended PR workflow
    "git status *": "allow",
    "git diff *": "allow",
    "git show *": "allow",
    "git log *": "allow",
    "git branch *": "allow",
    "git remote *": "allow",
    "git add *": "allow",
    "git commit *": "allow",
    "git push *": "allow",
    "git ls-remote *": "allow",

    // GitHub issue and PR workflow
    "gh label list *": "allow",
    "gh issue comment *": "allow",
    "gh issue create *": "allow",
    "gh issue list *": "allow",
    "gh issue edit *": "allow",
    "gh issue view *": "allow",
    "gh pr comment *": "allow",
    "gh pr create *": "allow",
    "gh pr edit *": "allow",
    "gh pr list *": "allow",
    "gh pr view *": "allow",
    "gh repo view *": "allow",
    "gh api *": "allow",

    "curl *": "ask",
    "rm *": "deny"
  }
}
}
