{
  "$schema": "https://opencode.ai/config.json",

  // Privacy / update preferences.
  "share": "disabled",
  "autoupdate": false,

  "default_agent": "livai-primary",
  "subagent_depth": 1,

  // Only expose providers you actually intend to use.
  "enabled_providers": [
    "openai",
    "github-copilot",
    "livai"
  ],

  "provider": {
    // Setup: https://llnl.servicenowservices.com/ess?id=kb_article_view&table=kb_knowledge&sys_id=62143123471ecb5408b62464336d43f4
    // List of models: https://livai-tools.llnl.gov/models
    "livai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LivAI API",

      "options": {
        "baseURL": "https://livai-api.llnl.gov",
        // TODO: INSERT LIVAI API KEY HERE
        "apiKey": "<INSERT LIVAI API KEY HERE>",
        "includeUsage": true,
        "apiVersion": "preview"
      },

      "models": {
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol",
          "variants": {
            "xhigh": { "reasoningEffort": "xhigh" },
            "high": { "reasoningEffort": "high" },
            "medium": { "reasoningEffort": "medium" },
            "low": { "reasoningEffort": "low" },
            "none": { "reasoningEffort": "none" }
          }
        },

        "gpt-6-luna": {
          "name": "GPT-6 Luna",
          "variants": {
            "xhigh": { "reasoningEffort": "xhigh" },
            "high": { "reasoningEffort": "high" },
            "medium": { "reasoningEffort": "medium" },
            "low": { "reasoningEffort": "low" },
            "none": { "reasoningEffort": "none" }
          }
        },

        "gpt-6-sol": {
          "name": "GPT-6 Sol",
          "variants": {
            "xhigh": { "reasoningEffort": "xhigh" },
            "high": { "reasoningEffort": "high" },
            "medium": { "reasoningEffort": "medium" },
            "low": { "reasoningEffort": "low" },
            "none": { "reasoningEffort": "none" }
          }
        },

        "gpt-6-astra": {
          "name": "GPT-6 Astra",
          "variants": {
            "xhigh": { "reasoningEffort": "xhigh" },
            "high": { "reasoningEffort": "high" },
            "medium": { "reasoningEffort": "medium" },
            "low": { "reasoningEffort": "low" },
            "none": { "reasoningEffort": "none" }
          }
        }
      }
    }
  },

  "agent": {
    "primary": {
      "description": "Plans, implements, tests, and fixes the task end-to-end.",
      "mode": "primary",
      "model": "openai/gpt-6.1-sol",
      "variant": "medium",
      "reasoningEffort": "medium",
      "permission": {
        "task": { "*": "deny", "explorer": "allow", "reviewer": "allow" },
        "skill": "deny"
      },
      "prompt": "Determine intent first. Answer questions and review-only requests without editing. For 'plan first', 'no code', or unclear authorization, present the answer or plan and stop without edits or mutating commands; a plan is not permission to implement. For explicit implementation requests, finish through verification without another approval turn. Plan from inspected code; use the repository's plan format or a short checklist of files, behavior, and checks. Run one command per bash call; use the bash workdir parameter instead of cd; do not pipe output to head, tail, or grep. Commit only when the user or an invoked command authorizes it. Before each commit, inspect git status, git diff, and git log --oneline -10; stage only intended changes and match repository commit style. Never push or open a PR without separate authorization. Work directly. Ask explorer only a precise, read-only codebase question that removes material uncertainty. Ask reviewer only when the user requests it or the change is risky. No parallel edits or recursive delegation. End with a brief summary: what changed, checks run, and relevant checks skipped and why. Say plainly if work is incomplete; never imply checks ran when they did not."
    },

    "explorer": {
      "description": "Performs targeted, read-only codebase investigation.",
      "mode": "subagent",
      "model": "openai/gpt-6-luna",
      "variant": "low",
      "reasoningEffort": "low",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "skill": { "*": "deny", "explore": "allow" },
        "external_directory": { "*": "deny", "~/worktrees/**": "allow" },
        "webfetch": "deny",
        "websearch": "deny"
      },
      "prompt": "Answer only the requested repository investigation. Search and read the codebase; do not edit files, run shell commands, browse the web, plan implementation, or delegate. Return concise findings with file paths and relevant symbols."
    },

    "livai-primary": {
      "description": "LivAI-backed primary agent that plans, implements, tests, and fixes end-to-end.",
      "mode": "primary",
      "model": "livai/gpt-6.1-sol",
      "variant": "medium",
      "reasoningEffort": "medium",
      "permission": {
        "task": { "*": "deny", "livai-explorer": "allow", "reviewer": "allow" },
        "skill": "deny"
      },
      "prompt": "Determine intent first. Answer questions and review-only requests without editing. For 'plan first', 'no code', or unclear authorization, present the answer or plan and stop without edits or mutating commands; a plan is not permission to implement. For explicit implementation requests, finish through verification without another approval turn. Plan from inspected code; use the repository's plan format or a short checklist of files, behavior, and checks. Run one command per bash call; use the bash workdir parameter instead of cd; do not pipe output to head, tail, or grep. Commit only when the user or an invoked command authorizes it. Before each commit, inspect git status, git diff, and git log --oneline -10; stage only intended changes and match repository commit style. Never push or open a PR without separate authorization. Work directly. Ask livai-explorer only a precise, read-only codebase question that removes material uncertainty. Ask reviewer only when the user requests it or the change is risky. No parallel edits or recursive delegation. End with a brief summary: what changed, checks run, and relevant checks skipped and why. Say plainly if work is incomplete; never imply checks ran when they did not."
    },

    "livai-explorer": {
      "description": "LivAI-backed explorer for targeted, read-only codebase investigation.",
      "mode": "subagent",
      "model": "livai/gpt-6-luna",
      "variant": "low",
      "reasoningEffort": "low",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny",
        "skill": { "*": "deny", "explore": "allow" },
        "external_directory": { "*": "deny", "~/worktrees/**": "allow" },
        "webfetch": "deny",
        "websearch": "deny"
      },
      "prompt": "Answer only the requested repository investigation. Search and read the codebase; do not edit files, run shell commands, browse the web, plan implementation, or delegate. Return concise findings with file paths and relevant symbols."
    },

    "reviewer": {
      "description": "Independently reviews substantial completed changes without editing them.",
      "mode": "subagent",
      "model": "github-copilot/claude-opus-5.5",
      "variant": "high",
      "permission": {
        "edit": "deny",
        "bash": { "*": "deny", "git status*": "allow", "git diff*": "allow", "git show*": "allow" },
        "task": "deny",
        "skill": { "*": "deny", "review": "allow" },
        "external_directory": { "*": "deny", "~/worktrees/**": "allow" },
        "webfetch": "deny",
        "websearch": "deny"
      },
      "prompt": "Independently review the completed implementation and provided check results. Focus on concrete correctness, regressions, edge cases, security, concurrency, error handling, API compatibility, unnecessary complexity, and missing tests. Do not modify code or delegate. Report only actionable findings, with file and line references when possible."
    }
  },
  "permission": {
    "skill": "allow",
    "task": "allow",
    "edit": "allow",
    "doom_loop": "ask",

    "external_directory": {
      "*": "ask",
      "~/worktrees/**": "allow",
      "/tmp/opencode/**": "allow"
    },

    "bash": {
      "*": "ask",

      // Inspection
      "pwd": "allow",
      "ls": "allow",
      "ls *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      // Read-only helpers often chained with allowed commands
      "cd *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "which *": "allow",
      "echo *": "allow",
      "sort *": "allow",
      "sed -n *": "allow",
      "find *": "allow",
      "find * -delete*": "ask",
      "find * -exec*": "ask",

      // Python checks: no blanket uv grant
      "pytest": "allow",
      "pytest *": "allow",
      "ruff *": "allow",
      "uv run pytest": "allow",
      "uv run pytest *": "allow",
      "uv run ruff *": "allow",
      "uv run ty check": "allow",
      "uv run ty check *": "allow",
      "pre-commit run --files *": "allow",
      "uv run pre-commit run --files *": "allow",
      // Targeted pytest options through allowed test commands
      "PYTEST_ADDOPTS=* pytest *": "allow",
      "PYTEST_ADDOPTS=* uv run pytest *": "allow",
      "PYTEST_ADDOPTS=* make test": "allow",
      "PYTEST_ADDOPTS=* make backend-test": "allow",

      // Frontend checks
      "pnpm run build": "allow",
      "pnpm run ci": "allow",
      "pnpm run type-check": "allow",
      "pnpm lint": "allow",
      "pnpm type-check": "allow",
      "pnpm --dir frontend run lint": "allow",
      "pnpm --dir frontend run type-check": "allow",
      "pnpm --dir frontend run ci": "allow",
      "pnpm --dir frontend run format:check": "allow",
      "make frontend-lint": "allow",
      "make frontend-build": "allow",

      // Repository checks
      "make help": "allow",
      "make test": "allow",
      "make test-all": "allow",
      "make structure-test": "allow",
      "make backend-test": "allow",
      "make pre-commit-run": "allow",

      // Trusted maintenance
      "make install-opencode-skills": "allow",
      "make install-opencode-commands": "allow",
      "make refresh-models": "allow",
      "make update-opencode": "allow",
      "make update-livai-models": "allow",
      "make update-opencode-instructions": "allow",
      "make update-opencode-skills": "allow",
      "make update-opencode-commands": "allow",

      // Approval for broad installation and agent/permission changes
      "make install": "ask",
      "make install-skills": "ask",
      "make install-commands": "ask",
      "make update-all": "ask",
      "make update-agents-md": "ask",
      "make update-skills": "ask",
      "make update-commands": "ask",
      "make update-skills-commands": "ask",
      "make update-agents": "ask",
      "make update-permissions": "ask",
      "make install-nersc-rules": "ask",
      "make uninstall-nersc-rules": "ask",

      // Conda inspection and activation
      "conda info": "allow",
      "conda info *": "allow",
      "conda list": "allow",
      "conda list *": "allow",
      "conda search *": "allow",
      "conda env list": "allow",
      "conda env list *": "allow",
      "conda env export": "allow",
      "conda env export *": "allow",
      "conda activate *": "allow",
      "conda deactivate": "allow",

      // Trusted environment management
      "conda create *": "allow",
      "conda install *": "allow",
      "conda update *": "allow",
      "conda env create *": "allow",
      "conda env update *": "allow",

      // Arbitrary execution, removal, and configuration
      "conda run *": "ask",
      "conda remove *": "ask",
      "conda uninstall *": "ask",
      "conda env remove *": "ask",
      "conda clean *": "ask",
      "conda config *": "ask",
      "conda init": "ask",
      "conda init *": "ask",

      // Git inspection: no blanket git grant
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git show": "allow",
      "git show *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git branch": "allow",
      "git branch --list": "allow",
      "git branch --list *": "allow",
      "git branch --show-current": "allow",
      "git remote": "allow",
      "git remote -v": "allow",
      "git remote get-url *": "allow",
      "git ls-remote": "allow",
      "git ls-remote *": "allow",
      "git worktree list": "allow",
      "git worktree list *": "allow",

      // Intended autonomous publishing workflow
      "git add *": "allow",
      "git commit": "allow",
      "git commit *": "allow",
      "git push": "allow",
      "git push *": "allow",

      // GitHub inspection
      "gh label list": "allow",
      "gh label list *": "allow",
      "gh issue list": "allow",
      "gh issue list *": "allow",
      "gh issue view *": "allow",
      "gh pr list": "allow",
      "gh pr list *": "allow",
      "gh pr view *": "allow",
      "gh repo view": "allow",
      "gh repo view *": "allow",

      // Intended GitHub writes
      "gh issue comment *": "allow",
      "gh issue create *": "allow",
      "gh issue edit *": "allow",
      "gh pr comment *": "allow",
      "gh pr create *": "allow",
      "gh pr edit *": "allow",

      // General API access and direct deletion
      "gh api *": "ask",
      "curl *": "ask",
      "rm": "deny",
      "rm *": "deny"
    }
  }
}
