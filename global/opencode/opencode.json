{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "workflow-orchestrator",
  "subagent_depth": 1,
  "agent": {
    "workflow-orchestrator": {
      "description": "Plans work, delegates bounded tasks, runs final checks, and coordinates independent review.",
      "model": "openai/gpt-5.6-sol",
      "mode": "primary",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "bash": "allow",
        "task": {
          "*": "deny",
          "explore": "allow",
          "general": "allow",
          "workflow-reviewer": "allow"
        },
        "todowrite": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "lsp": "allow",
        "skill": "allow",
        "external_directory": "ask"
      },
      "reasoningEffort": "high",
      "textVerbosity": "low"
    },
    "explore": {
      "description": "Performs fast, read-only repository discovery and returns concise findings.",
      "model": "openai/gpt-5.6-luna",
      "mode": "subagent",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": "allow",
        "external_directory": "deny"
      },
      "reasoningEffort": "low",
      "textVerbosity": "low"
    },
    "workflow-reviewer": {
      "description": "Independently reviews the requested behavior, resulting changes, and test evidence without modifying files.",
      "model": "github-copilot/claude-sonnet-5",
      "mode": "subagent",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "skill": "allow",
        "external_directory": "deny"
      }
    },
    "general": {
      "description": "Implements well-scoped delegated work, including edits and relevant tests; use for independent parallel work.",
      "prompt": "Handle only the assigned scope. Make minimal changes, respect repository instructions and file ownership, run relevant checks, and report changed files, test results, and blockers. Do not commit, push, or modify unrelated files.",
      "model": "openai/gpt-5.6-terra",
      "mode": "subagent",
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": "allow",
        "bash": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "lsp": "allow",
        "skill": "allow",
        "external_directory": "deny"
      },
      "reasoningEffort": "medium",
      "textVerbosity": "low"
    },
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  }
}
